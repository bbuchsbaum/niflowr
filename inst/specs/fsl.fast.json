{
  "spec_version": "0.1.0",
  "id": "fsl.fast",
  "title": "FSL FAST",
  "command": "fast",
  "inputs": {
    "args": {
      "type": "string",
      "desc": "Additional parameters to the command",
      "cli": {
        "argstr": "%s"
      }
    },
    "bias_iters": {
      "type": "int",
      "desc": "number of main-loop iterations during bias-field removal",
      "cli": {
        "argstr": "-I %d"
      }
    },
    "bias_lowpass": {
      "type": "int",
      "desc": "bias field smoothing extent (FWHM) in mm",
      "cli": {
        "argstr": "-l %d"
      }
    },
    "hyper": {
      "type": "double",
      "desc": "segmentation spatial smoothness",
      "cli": {
        "argstr": "-H %.2f"
      }
    },
    "img_type": {
      "type": "enum",
      "desc": "int specifying type of image: (1 = T1, 2 = T2, 3 = PD)",
      "choices": [
        1,
        2,
        3
      ],
      "cli": {
        "argstr": "-t %d"
      }
    },
    "in_files": {
      "type": "list",
      "desc": "image, or multi-channel set of images, to be segmented",
      "required": true,
      "cli": {
        "argstr": "%s",
        "position": -1
      },
      "validate": {
        "exists": true
      },
      "items_type": "file"
    },
    "init_seg_smooth": {
      "type": "double",
      "desc": "initial segmentation spatial smoothness (during bias field estimation)",
      "cli": {
        "argstr": "-f %.3f"
      }
    },
    "init_transform": {
      "type": "file",
      "desc": "<standard2input.mat> initialise using priors",
      "cli": {
        "argstr": "-a %s"
      }
    },
    "iters_afterbias": {
      "type": "int",
      "desc": "number of main-loop iterations after bias-field removal",
      "cli": {
        "argstr": "-O %d"
      }
    },
    "manual_seg": {
      "type": "file",
      "desc": "Filename containing intensities",
      "cli": {
        "argstr": "-s %s"
      }
    },
    "mixel_smooth": {
      "type": "double",
      "desc": "spatial smoothness for mixeltype",
      "cli": {
        "argstr": "-R %.2f"
      }
    },
    "no_bias": {
      "type": "flag",
      "desc": "do not remove bias field",
      "cli": {
        "argstr": "-N"
      }
    },
    "no_pve": {
      "type": "flag",
      "desc": "turn off PVE (partial volume estimation)",
      "cli": {
        "argstr": "--nopve"
      }
    },
    "number_classes": {
      "type": "int",
      "desc": "number of tissue-type classes",
      "cli": {
        "argstr": "-n %d"
      },
      "default": 3,
      "validate": {
        "min": 1,
        "max": 10
      }
    },
    "other_priors": {
      "type": "list",
      "desc": "alternative prior images",
      "cli": {
        "argstr": "-A %s"
      },
      "items_type": "file"
    },
    "out_basename": {
      "type": "file",
      "desc": "base name of output files",
      "cli": {
        "argstr": "-o %s",
        "strip_ext": true
      },
      "role": "output"
    },
    "output_biascorrected": {
      "type": "flag",
      "desc": "output restored image (bias-corrected image)",
      "cli": {
        "argstr": "-B"
      }
    },
    "output_biasfield": {
      "type": "flag",
      "desc": "output estimated bias field",
      "cli": {
        "argstr": "-b"
      }
    },
    "probability_maps": {
      "type": "flag",
      "desc": "outputs individual probability maps",
      "cli": {
        "argstr": "-p"
      }
    },
    "segment_iters": {
      "type": "int",
      "desc": "number of segmentation-initialisation iterations",
      "cli": {
        "argstr": "-W %d"
      }
    },
    "segments": {
      "type": "flag",
      "desc": "outputs a separate binary image for each tissue type",
      "cli": {
        "argstr": "-g"
      }
    },
    "use_priors": {
      "type": "flag",
      "desc": "use priors throughout",
      "cli": {
        "argstr": "-P"
      }
    },
    "verbose": {
      "type": "flag",
      "desc": "switch on diagnostic messages",
      "cli": {
        "argstr": "-v"
      }
    }
  },
  "outputs": {
    "tissue_class_map": {
      "type": "file",
      "path": {
        "computed": true
      },
      "must_exist": true
    },
    "partial_volume_files": {
      "type": "list",
      "path": {
        "computed": true
      },
      "must_exist": true
    },
    "partial_volume_map": {
      "type": "file",
      "path": {
        "computed": true
      },
      "must_exist": true
    },
    "mixeltype": {
      "type": "file",
      "path": {
        "computed": true
      },
      "must_exist": true
    },
    "tissue_class_files": {
      "type": "list",
      "path": {
        "computed": true
      },
      "must_exist": true
    },
    "restored_image": {
      "type": "list",
      "path": {
        "computed": true
      },
      "must_exist": true
    },
    "bias_field": {
      "type": "list",
      "path": {
        "computed": true
      },
      "must_exist": true
    },
    "probability_maps": {
      "type": "list",
      "path": {
        "computed": true
      },
      "must_exist": true
    }
  },
  "runtime": {
    "profile": "fsl",
    "env": {
      "FSLOUTPUTTYPE": "NIFTI_GZ"
    }
  },
  "origin": {
    "source": "nipype",
    "nipype_class": "nipype.interfaces.fsl.preprocess.FAST",
    "nipype_version": "1.10.0"
  },
  "description": "FSL FAST wrapper for segmentation and bias correction",
  "render": "fsl_fast",
  "output_resolver": "fsl_fast"
}
