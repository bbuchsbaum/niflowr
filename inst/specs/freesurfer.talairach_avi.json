{
  "spec_version": "0.1.0",
  "id": "freesurfer.talairach_avi",
  "title": "FREESURFER TalairachAVI",
  "command": "talairach_avi",
  "inputs": {
    "args": {
      "type": "string",
      "desc": "Additional parameters to the command",
      "cli": {
        "argstr": "%s"
      }
    },
    "atlas": {
      "type": "string",
      "desc": "alternate target atlas (in freesurfer/average dir)",
      "cli": {
        "argstr": "--atlas %s"
      }
    },
    "in_file": {
      "type": "file",
      "desc": "input volume",
      "required": true,
      "cli": {
        "argstr": "--i %s"
      }
    },
    "out_file": {
      "type": "file",
      "desc": "output xfm file",
      "required": true,
      "cli": {
        "argstr": "--xfm %s"
      }
    }
  },
  "outputs": {
    "out_file": {
      "type": "file",
      "path": {
        "from_input": "out_file"
      },
      "must_exist": false
    }
  },
  "runtime": {
    "profile": "freesurfer"
  },
  "origin": {
    "source": "nipype",
    "nipype_class": "nipype.interfaces.freesurfer.utils.TalairachAVI",
    "nipype_version": "1.10.0"
  },
  "description": "Front-end for Avi Snyders image registration tool. Computes the"
}
