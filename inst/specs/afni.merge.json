{
  "spec_version": "0.1.0",
  "id": "afni.merge",
  "title": "AFNI Merge",
  "command": "3dmerge",
  "inputs": {
    "args": {
      "type": "string",
      "desc": "Additional parameters to the command",
      "cli": {
        "argstr": "%s"
      }
    },
    "blurfwhm": {
      "type": "int",
      "desc": "FWHM blur value (mm)",
      "cli": {
        "argstr": "-1blur_fwhm %d"
      }
    },
    "doall": {
      "type": "flag",
      "desc": "apply options to all sub-bricks in dataset",
      "cli": {
        "argstr": "-doall"
      }
    },
    "in_files": {
      "type": "list",
      "required": true,
      "cli": {
        "argstr": "%s",
        "position": -1
      }
    },
    "out_file": {
      "type": "file",
      "desc": "output image file name",
      "cli": {
        "argstr": "-prefix %s"
      }
    }
  },
  "outputs": {
    "out_file": {
      "type": "file",
      "path": {
        "from_input": "out_file"
      },
      "must_exist": false
    }
  },
  "runtime": {
    "container": {
      "type": "none"
    }
  },
  "origin": {
    "source": "nipype",
    "nipype_class": "nipype.interfaces.afni.utils.Merge",
    "nipype_version": "1.10.0"
  },
  "description": "Merge or edit volumes using AFNI 3dmerge command"
}
