{
  "spec_version": "0.1.0",
  "id": "ants.warp_image_multi_transform",
  "title": "ANTS WarpImageMultiTransform",
  "command": "WarpImageMultiTransform",
  "inputs": {
    "args": {
      "type": "string",
      "desc": "Additional parameters to the command",
      "cli": {
        "argstr": "%s"
      }
    },
    "dimension": {
      "type": "enum",
      "desc": "image dimension (2 or 3)",
      "default": 3,
      "choices": [
        3,
        2
      ],
      "cli": {
        "argstr": "%d",
        "position": 1
      }
    },
    "input_image": {
      "type": "file",
      "desc": "image to apply transformation to (generally a coregistered functional)",
      "required": true,
      "cli": {
        "argstr": "%s",
        "position": 2
      }
    },
    "output_image": {
      "type": "file",
      "desc": "name of the output warped image",
      "cli": {
        "argstr": "%s",
        "position": 3
      },
      "constraints": {}
    },
    "reference_image": {
      "type": "file",
      "desc": "reference image space that you wish to warp INTO",
      "cli": {
        "argstr": "-R %s"
      },
      "constraints": {
        "xor": [
          "tightest_box"
        ]
      }
    },
    "reslice_by_header": {
      "type": "flag",
      "desc": "Uses orientation matrix and origin encoded in reference image file header. Not typically used with additional transforms",
      "cli": {
        "argstr": "--reslice-by-header"
      }
    },
    "tightest_box": {
      "type": "flag",
      "desc": "computes tightest bounding box (overridden by reference_image if given)",
      "cli": {
        "argstr": "--tightest-bounding-box"
      },
      "constraints": {
        "xor": [
          "reference_image"
        ]
      }
    },
    "transformation_series": {
      "type": "list",
      "desc": "transformation file(s) to be applied",
      "required": true,
      "cli": {
        "argstr": "%s",
        "position": -1
      }
    },
    "use_bspline": {
      "type": "flag",
      "desc": "Use 3rd order B-Spline interpolation",
      "cli": {
        "argstr": "--use-BSpline"
      }
    },
    "use_nearest": {
      "type": "flag",
      "desc": "Use nearest neighbor interpolation",
      "cli": {
        "argstr": "--use-NN"
      }
    }
  },
  "outputs": {
    "output_image": {
      "type": "file",
      "path": {
        "from_input": "output_image"
      },
      "must_exist": false
    }
  },
  "runtime": {
    "container": {
      "type": "none"
    }
  },
  "origin": {
    "source": "nipype",
    "nipype_class": "nipype.interfaces.ants.resampling.WarpImageMultiTransform",
    "nipype_version": "1.10.0"
  },
  "description": "Warps an image from one space to another"
}
