{
  "spec_version": "0.1.0",
  "id": "fsl.find_the_biggest",
  "title": "FSL FindTheBiggest",
  "command": "find_the_biggest",
  "inputs": {
    "args": {
      "type": "string",
      "desc": "Additional parameters to the command",
      "cli": {
        "argstr": "%s"
      }
    },
    "in_files": {
      "type": "list",
      "desc": "a list of input volumes or a singleMatrixFile",
      "required": true,
      "cli": {
        "argstr": "%s",
        "position": 0
      }
    },
    "out_file": {
      "type": "file",
      "desc": "file with the resulting segmentation",
      "cli": {
        "argstr": "%s",
        "position": 2
      }
    }
  },
  "outputs": {
    "out_file": {
      "type": "file",
      "path": {
        "from_input": "out_file"
      },
      "must_exist": false
    }
  },
  "runtime": {
    "profile": "fsl"
  },
  "origin": {
    "source": "nipype",
    "nipype_class": "nipype.interfaces.fsl.dti.FindTheBiggest",
    "nipype_version": "1.10.0"
  },
  "description": "Use FSL find_the_biggest for performing hard segmentation on"
}
