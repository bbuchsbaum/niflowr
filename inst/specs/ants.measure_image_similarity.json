{
  "spec_version": "0.1.0",
  "id": "ants.measure_image_similarity",
  "title": "ANTS MeasureImageSimilarity",
  "command": "MeasureImageSimilarity",
  "inputs": {
    "args": {
      "type": "string",
      "desc": "Additional parameters to the command",
      "cli": {
        "argstr": "%s"
      }
    },
    "dimension": {
      "type": "enum",
      "desc": "Dimensionality of the fixed/moving image pair",
      "choices": [
        2,
        3,
        4
      ],
      "cli": {
        "argstr": "--dimensionality %d",
        "position": 1
      },
      "default": 3
    },
    "fixed_image": {
      "type": "file",
      "desc": "Image to which the moving image is warped",
      "required": true,
      "validate": {
        "exists": true
      }
    },
    "fixed_image_mask": {
      "type": "file",
      "desc": "Mask limiting the voxels the metric considers, in fixed-image space. MeasureImageSimilarity ignores a mask it cannot read, so the path must exist.",
      "cli": {
        "argstr": "%s"
      },
      "validate": {
        "exists": true
      }
    },
    "metric": {
      "type": "enum",
      "required": true,
      "choices": [
        "CC",
        "MI",
        "Mattes",
        "MeanSquares",
        "Demons",
        "GC"
      ],
      "cli": {
        "argstr": "%s"
      }
    },
    "moving_image": {
      "type": "file",
      "desc": "Image to apply transformation to (generally a coregistered functional)",
      "required": true,
      "validate": {
        "exists": true
      }
    },
    "radius_or_number_of_bins": {
      "type": "int",
      "desc": "Number of histogram bins for MI and Mattes, or neighbourhood radius for CC.",
      "required": true,
      "constraints": {
        "requires": [
          "metric"
        ]
      }
    },
    "sampling_percentage": {
      "type": "double",
      "desc": "Fraction of voxels sampled, in (0, 1]; requires sampling_strategy.",
      "required": false,
      "constraints": {
        "requires": [
          "sampling_strategy"
        ]
      },
      "validate": {
        "min": 0,
        "max": 1
      }
    },
    "metric_weight": {
      "type": "double",
      "default": 1,
      "desc": "Metric weight (not used by MeasureImageSimilarity; kept for the metric token)."
    },
    "sampling_strategy": {
      "type": "enum",
      "choices": [
        "None",
        "Regular",
        "Random"
      ],
      "desc": "Metric sampling strategy; omitted means dense sampling (one sample per voxel)."
    },
    "moving_image_mask": {
      "type": "file",
      "desc": "Mask in moving-image space; requires fixed_image_mask.",
      "validate": {
        "exists": true
      },
      "constraints": {
        "requires": [
          "fixed_image_mask"
        ]
      }
    }
  },
  "outputs": {},
  "runtime": {
    "profile": "ants"
  },
  "origin": {
    "source": "nipype",
    "nipype_class": "nipype.interfaces.ants.registration.MeasureImageSimilarity",
    "nipype_version": "1.10.0"
  },
  "description": "Examples",
  "render": "ants_measure_image_similarity"
}
