{
  "spec_version": "0.1.0",
  "id": "fsl.split",
  "title": "FSL Split",
  "command": "fslsplit",
  "inputs": {
    "args": {
      "type": "string",
      "desc": "Additional parameters to the command",
      "cli": {
        "argstr": "%s"
      }
    },
    "dimension": {
      "type": "enum",
      "desc": "dimension along which the file will be split",
      "required": true,
      "choices": [
        "t",
        "x",
        "y",
        "z"
      ],
      "cli": {
        "argstr": "-%s",
        "position": 2
      }
    },
    "in_file": {
      "type": "file",
      "desc": "input filename",
      "required": true,
      "cli": {
        "argstr": "%s",
        "position": 0
      }
    },
    "out_base_name": {
      "type": "string",
      "desc": "outputs prefix",
      "cli": {
        "argstr": "%s",
        "position": 1
      }
    }
  },
  "outputs": {},
  "runtime": {
    "container": {
      "type": "none"
    }
  },
  "origin": {
    "source": "nipype",
    "nipype_class": "nipype.interfaces.fsl.utils.Split",
    "nipype_version": "1.10.0"
  },
  "description": "Uses FSL Fslsplit command to separate a volume into images in"
}
