{
  "spec_version": "0.1.0",
  "id": "fsl.sig_loss",
  "title": "FSL SigLoss",
  "command": "sigloss",
  "inputs": {
    "args": {
      "type": "string",
      "desc": "Additional parameters to the command",
      "cli": {
        "argstr": "%s"
      }
    },
    "echo_time": {
      "type": "double",
      "desc": "echo time in seconds",
      "cli": {
        "argstr": "--te=%f"
      }
    },
    "in_file": {
      "type": "file",
      "desc": "b0 fieldmap file",
      "required": true,
      "cli": {
        "argstr": "-i %s"
      }
    },
    "mask_file": {
      "type": "file",
      "desc": "brain mask file",
      "cli": {
        "argstr": "-m %s"
      }
    },
    "out_file": {
      "type": "file",
      "desc": "output signal loss estimate file",
      "cli": {
        "argstr": "-s %s"
      }
    },
    "slice_direction": {
      "type": "enum",
      "desc": "slicing direction",
      "choices": [
        "x",
        "y",
        "z"
      ],
      "cli": {
        "argstr": "-d %s"
      }
    }
  },
  "outputs": {
    "out_file": {
      "type": "file",
      "path": {
        "from_input": "out_file"
      },
      "must_exist": false
    }
  },
  "runtime": {
    "container": {
      "type": "none"
    }
  },
  "origin": {
    "source": "nipype",
    "nipype_class": "nipype.interfaces.fsl.utils.SigLoss",
    "nipype_version": "1.10.0"
  },
  "description": "Estimates signal loss from a field map (in rad/s)"
}
