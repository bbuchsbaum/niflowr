{
  "spec_version": "0.1.0",
  "id": "fsl.convert_xfm",
  "title": "FSL ConvertXFM",
  "command": "convert_xfm",
  "inputs": {
    "args": {
      "type": "string",
      "desc": "Additional parameters to the command",
      "cli": {
        "argstr": "%s"
      }
    },
    "concat_xfm": {
      "type": "flag",
      "desc": "write joint transformation of two input matrices",
      "cli": {
        "argstr": "-concat",
        "position": -3
      },
      "constraints": {
        "xor": [
          "invert_xfm",
          "concat_xfm",
          "fix_scale_skew"
        ],
        "requires": [
          "in_file2"
        ]
      }
    },
    "fix_scale_skew": {
      "type": "flag",
      "desc": "use secondary matrix to fix scale and skew",
      "cli": {
        "argstr": "-fixscaleskew",
        "position": -3
      },
      "constraints": {
        "xor": [
          "invert_xfm",
          "concat_xfm",
          "fix_scale_skew"
        ],
        "requires": [
          "in_file2"
        ]
      }
    },
    "in_file": {
      "type": "file",
      "desc": "input transformation matrix",
      "required": true,
      "cli": {
        "argstr": "%s",
        "position": -1
      }
    },
    "in_file2": {
      "type": "file",
      "desc": "second input matrix (for use with fix_scale_skew or concat_xfm)",
      "cli": {
        "argstr": "%s",
        "position": -2
      }
    },
    "invert_xfm": {
      "type": "flag",
      "desc": "invert input transformation",
      "cli": {
        "argstr": "-inverse",
        "position": -3
      },
      "constraints": {
        "xor": [
          "invert_xfm",
          "concat_xfm",
          "fix_scale_skew"
        ]
      }
    },
    "out_file": {
      "type": "file",
      "desc": "final transformation matrix",
      "cli": {
        "argstr": "-omat %s",
        "position": 1
      }
    }
  },
  "outputs": {
    "out_file": {
      "type": "file",
      "path": {
        "from_input": "out_file"
      },
      "must_exist": false
    }
  },
  "runtime": {
    "container": {
      "type": "none"
    }
  },
  "origin": {
    "source": "nipype",
    "nipype_class": "nipype.interfaces.fsl.utils.ConvertXFM",
    "nipype_version": "1.10.0"
  },
  "description": "Use the FSL utility convert_xfm to modify FLIRT transformation matrices."
}
