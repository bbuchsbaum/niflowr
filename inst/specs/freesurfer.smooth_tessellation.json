{
  "spec_version": "0.1.0",
  "id": "freesurfer.smooth_tessellation",
  "title": "FREESURFER SmoothTessellation",
  "command": "mris_smooth",
  "inputs": {
    "args": {
      "type": "string",
      "desc": "Additional parameters to the command",
      "cli": {
        "argstr": "%s"
      }
    },
    "curvature_averaging_iterations": {
      "type": "int",
      "desc": "Number of curvature averaging iterations (default=10)",
      "cli": {
        "argstr": "-a %d"
      }
    },
    "disable_estimates": {
      "type": "flag",
      "desc": "Disables the writing of curvature and area estimates",
      "cli": {
        "argstr": "-nw"
      }
    },
    "gaussian_curvature_norm_steps": {
      "type": "int",
      "desc": "Use Gaussian curvature smoothing",
      "cli": {
        "argstr": "%d"
      }
    },
    "gaussian_curvature_smoothing_steps": {
      "type": "int",
      "desc": "Use Gaussian curvature smoothing",
      "cli": {
        "argstr": "%d"
      }
    },
    "in_file": {
      "type": "file",
      "desc": "Input volume to tessellate voxels from.",
      "required": true,
      "cli": {
        "argstr": "%s",
        "position": -2
      }
    },
    "normalize_area": {
      "type": "flag",
      "desc": "Normalizes the area after smoothing",
      "cli": {
        "argstr": "-area"
      }
    },
    "out_area_file": {
      "type": "file",
      "desc": "Write area to ``?h.areaname`` (default \"area\")",
      "cli": {
        "argstr": "-b %s"
      }
    },
    "out_curvature_file": {
      "type": "file",
      "desc": "Write curvature to ``?h.curvname`` (default \"curv\")",
      "cli": {
        "argstr": "-c %s"
      }
    },
    "out_file": {
      "type": "file",
      "desc": "output filename or True to generate one",
      "cli": {
        "argstr": "%s",
        "position": -1
      }
    },
    "seed": {
      "type": "int",
      "desc": "Seed for setting random number generator",
      "cli": {
        "argstr": "-seed %d"
      }
    },
    "smoothing_iterations": {
      "type": "int",
      "desc": "Number of smoothing iterations (default=10)",
      "cli": {
        "argstr": "-n %d"
      }
    },
    "snapshot_writing_iterations": {
      "type": "int",
      "desc": "Write snapshot every *n* iterations",
      "cli": {
        "argstr": "-w %d"
      }
    },
    "use_gaussian_curvature_smoothing": {
      "type": "flag",
      "desc": "Use Gaussian curvature smoothing",
      "cli": {
        "argstr": "-g"
      }
    },
    "use_momentum": {
      "type": "flag",
      "desc": "Uses momentum",
      "cli": {
        "argstr": "-m"
      }
    }
  },
  "outputs": {},
  "runtime": {
    "container": {
      "type": "none"
    }
  },
  "origin": {
    "source": "nipype",
    "nipype_class": "nipype.interfaces.freesurfer.utils.SmoothTessellation",
    "nipype_version": "1.10.0"
  },
  "description": "Smooth a tessellated surface."
}
