{
  "spec_version": "0.1.0",
  "id": "afni.axialize",
  "title": "AFNI Axialize",
  "command": "3daxialize",
  "inputs": {
    "args": {
      "type": "string",
      "desc": "Additional parameters to the command",
      "cli": {
        "argstr": "%s"
      }
    },
    "axial": {
      "type": "flag",
      "desc": "Do axial slice order    [-orient RAI]This is the default AFNI axial order, andis the one currently required by thevolume rendering plugin; this is alsothe default orientation output by thisprogram (hence the program's name).",
      "cli": {
        "argstr": "-axial"
      },
      "constraints": {
        "xor": [
          "coronal",
          "sagittal"
        ]
      }
    },
    "coronal": {
      "type": "flag",
      "desc": "Do coronal slice order  [-orient RSA]",
      "cli": {
        "argstr": "-coronal"
      },
      "constraints": {
        "xor": [
          "sagittal",
          "axial"
        ]
      }
    },
    "in_file": {
      "type": "file",
      "desc": "input file to 3daxialize",
      "required": true,
      "cli": {
        "argstr": "%s",
        "position": -2
      }
    },
    "orientation": {
      "type": "string",
      "desc": "new orientation code",
      "cli": {
        "argstr": "-orient %s"
      }
    },
    "out_file": {
      "type": "file",
      "desc": "output image file name",
      "cli": {
        "argstr": "-prefix %s"
      }
    },
    "sagittal": {
      "type": "flag",
      "desc": "Do sagittal slice order [-orient ASL]",
      "cli": {
        "argstr": "-sagittal"
      },
      "constraints": {
        "xor": [
          "coronal",
          "axial"
        ]
      }
    },
    "verb": {
      "type": "flag",
      "desc": "Print out a progerss report",
      "cli": {
        "argstr": "-verb"
      }
    }
  },
  "outputs": {
    "out_file": {
      "type": "file",
      "path": {
        "from_input": "out_file"
      },
      "must_exist": false
    }
  },
  "runtime": {
    "container": {
      "type": "none"
    }
  },
  "origin": {
    "source": "nipype",
    "nipype_class": "nipype.interfaces.afni.utils.Axialize",
    "nipype_version": "1.10.0"
  },
  "description": "Read in a dataset and write it out as a new dataset"
}
