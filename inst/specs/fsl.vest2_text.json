{
  "spec_version": "0.1.0",
  "id": "fsl.vest2_text",
  "title": "FSL Vest2Text",
  "command": "Vest2Text",
  "inputs": {
    "args": {
      "type": "string",
      "desc": "Additional parameters to the command",
      "cli": {
        "argstr": "%s"
      }
    },
    "in_file": {
      "type": "file",
      "desc": "matrix data stored in the format used by FSL tools",
      "required": true,
      "cli": {
        "argstr": "%s",
        "position": 0
      }
    },
    "out_file": {
      "type": "file",
      "desc": "file name to store text output from matrix",
      "default": "design.txt",
      "cli": {
        "argstr": "%s",
        "position": 1
      }
    }
  },
  "outputs": {
    "out_file": {
      "type": "file",
      "path": {
        "from_input": "out_file"
      },
      "must_exist": false
    }
  },
  "runtime": {
    "profile": "fsl"
  },
  "origin": {
    "source": "nipype",
    "nipype_class": "nipype.interfaces.fsl.utils.Vest2Text",
    "nipype_version": "1.10.0"
  },
  "description": "Use FSL Vest2Text`https://web.mit.edu/fsl_v5.0.10/fsl/doc/wiki/GLM(2f)CreatingDesignMatricesByHand.html`_"
}
