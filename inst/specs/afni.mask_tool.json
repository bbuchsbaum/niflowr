{
  "spec_version": "0.1.0",
  "id": "afni.mask_tool",
  "title": "AFNI MaskTool",
  "command": "3dmask_tool",
  "inputs": {
    "args": {
      "type": "string",
      "desc": "Additional parameters to the command",
      "cli": {
        "argstr": "%s"
      }
    },
    "count": {
      "type": "flag",
      "desc": "Instead of created a binary 0/1 mask dataset, create one with counts of voxel overlap, i.e., each voxel will contain the number of masks that it is set in.",
      "cli": {
        "argstr": "-count",
        "position": 2
      }
    },
    "datum": {
      "type": "enum",
      "desc": "specify data type for output.",
      "choices": [
        "byte",
        "short",
        "float"
      ],
      "cli": {
        "argstr": "-datum %s"
      }
    },
    "dilate_inputs": {
      "type": "string",
      "desc": "Use this option to dilate and/or erode datasets as they are read. ex. '5 -5' to dilate and erode 5 times",
      "cli": {
        "argstr": "-dilate_inputs %s"
      }
    },
    "dilate_results": {
      "type": "string",
      "desc": "dilate and/or erode combined mask at the given levels.",
      "cli": {
        "argstr": "-dilate_results %s"
      }
    },
    "fill_dirs": {
      "type": "string",
      "desc": "fill holes only in the given directions. This option is for use with -fill holes. should be a single string that specifies 1-3 of the axes using {x,y,z} labels (i.e. dataset axis order), or using the labels in {R,L,A,P,I,S}.",
      "cli": {
        "argstr": "-fill_dirs %s"
      },
      "constraints": {
        "requires": [
          "fill_holes"
        ]
      }
    },
    "fill_holes": {
      "type": "flag",
      "desc": "This option can be used to fill holes in the resulting mask, i.e. after all other processing has been done.",
      "cli": {
        "argstr": "-fill_holes"
      }
    },
    "frac": {
      "type": "double",
      "desc": "When combining masks (across datasets and sub-bricks), use this option to restrict the result to a certain fraction of the set of volumes",
      "cli": {
        "argstr": "-frac %s"
      }
    },
    "in_file": {
      "type": "list",
      "desc": "input file or files to 3dmask_tool",
      "required": true,
      "cli": {
        "argstr": "-input %s",
        "position": -1
      }
    },
    "inter": {
      "type": "flag",
      "desc": "intersection, this means -frac 1.0",
      "cli": {
        "argstr": "-inter"
      }
    },
    "out_file": {
      "type": "file",
      "desc": "output image file name",
      "cli": {
        "argstr": "-prefix %s"
      }
    },
    "union": {
      "type": "flag",
      "desc": "union, this means -frac 0",
      "cli": {
        "argstr": "-union"
      }
    },
    "verbose": {
      "type": "int",
      "desc": "specify verbosity level, for 0 to 3",
      "cli": {
        "argstr": "-verb %s"
      }
    }
  },
  "outputs": {
    "out_file": {
      "type": "file",
      "path": {
        "from_input": "out_file"
      },
      "must_exist": false
    }
  },
  "runtime": {
    "container": {
      "type": "none"
    }
  },
  "origin": {
    "source": "nipype",
    "nipype_class": "nipype.interfaces.afni.utils.MaskTool",
    "nipype_version": "1.10.0"
  },
  "description": "3dmask_tool - for combining/dilating/eroding/filling masks"
}
