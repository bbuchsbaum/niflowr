{
  "spec_version": "0.1.0",
  "id": "afni.despike",
  "title": "AFNI Despike",
  "command": "3dDespike",
  "inputs": {
    "args": {
      "type": "string",
      "desc": "Additional parameters to the command",
      "cli": {
        "argstr": "%s"
      }
    },
    "in_file": {
      "type": "file",
      "desc": "input file to 3dDespike",
      "required": true,
      "cli": {
        "argstr": "%s",
        "position": -1
      }
    },
    "out_file": {
      "type": "file",
      "desc": "output image file name",
      "cli": {
        "argstr": "-prefix %s"
      }
    }
  },
  "outputs": {
    "out_file": {
      "type": "file",
      "path": {
        "from_input": "out_file"
      },
      "must_exist": false
    }
  },
  "runtime": {
    "profile": "afni"
  },
  "origin": {
    "source": "nipype",
    "nipype_class": "nipype.interfaces.afni.preprocess.Despike",
    "nipype_version": "1.10.0"
  },
  "description": "Removes 'spikes' from the 3D+time input dataset"
}
