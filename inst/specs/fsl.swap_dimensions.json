{
  "spec_version": "0.1.0",
  "id": "fsl.swap_dimensions",
  "title": "FSL SwapDimensions",
  "command": "fslswapdim",
  "inputs": {
    "args": {
      "type": "string",
      "desc": "Additional parameters to the command",
      "cli": {
        "argstr": "%s"
      }
    },
    "in_file": {
      "type": "file",
      "desc": "input image",
      "required": true,
      "cli": {
        "argstr": "%s"
      }
    },
    "new_dims": {
      "type": "list",
      "desc": "3-tuple of new dimension order",
      "required": true,
      "cli": {
        "argstr": "%s %s %s"
      }
    },
    "out_file": {
      "type": "file",
      "desc": "image to write",
      "cli": {
        "argstr": "%s"
      }
    }
  },
  "outputs": {
    "out_file": {
      "type": "file",
      "path": {
        "from_input": "out_file"
      },
      "must_exist": false
    }
  },
  "runtime": {
    "profile": "fsl"
  },
  "origin": {
    "source": "nipype",
    "nipype_class": "nipype.interfaces.fsl.utils.SwapDimensions",
    "nipype_version": "1.10.0"
  },
  "description": "Use fslswapdim to alter the orientation of an image."
}
