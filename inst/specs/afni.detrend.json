{
  "spec_version": "0.1.0",
  "id": "afni.detrend",
  "title": "AFNI Detrend",
  "command": "3dDetrend",
  "inputs": {
    "args": {
      "type": "string",
      "desc": "Additional parameters to the command",
      "cli": {
        "argstr": "%s"
      }
    },
    "in_file": {
      "type": "file",
      "desc": "input file to 3dDetrend",
      "required": true,
      "cli": {
        "argstr": "%s",
        "position": -1
      }
    },
    "out_file": {
      "type": "file",
      "desc": "output image file name",
      "cli": {
        "argstr": "-prefix %s"
      }
    }
  },
  "outputs": {
    "out_file": {
      "type": "file",
      "path": {
        "from_input": "out_file"
      },
      "must_exist": false
    }
  },
  "runtime": {
    "container": {
      "type": "none"
    }
  },
  "origin": {
    "source": "nipype",
    "nipype_class": "nipype.interfaces.afni.preprocess.Detrend",
    "nipype_version": "1.10.0"
  },
  "description": "This program removes components from voxel time series using"
}
