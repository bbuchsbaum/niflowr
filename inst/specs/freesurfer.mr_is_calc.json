{
  "spec_version": "0.1.0",
  "id": "freesurfer.mr_is_calc",
  "title": "FREESURFER MRIsCalc",
  "command": "mris_calc",
  "inputs": {
    "action": {
      "type": "string",
      "desc": "Action to perform on input file(s)",
      "required": true,
      "cli": {
        "argstr": "%s",
        "position": -2
      }
    },
    "args": {
      "type": "string",
      "desc": "Additional parameters to the command",
      "cli": {
        "argstr": "%s"
      }
    },
    "in_file1": {
      "type": "file",
      "desc": "Input file 1",
      "required": true,
      "cli": {
        "argstr": "%s",
        "position": -3
      }
    },
    "in_file2": {
      "type": "file",
      "desc": "Input file 2",
      "cli": {
        "argstr": "%s",
        "position": -1
      },
      "constraints": {
        "xor": [
          "in_float",
          "in_int"
        ]
      }
    },
    "in_float": {
      "type": "double",
      "desc": "Input float",
      "cli": {
        "argstr": "%f",
        "position": -1
      },
      "constraints": {
        "xor": [
          "in_file2",
          "in_int"
        ]
      }
    },
    "in_int": {
      "type": "int",
      "desc": "Input integer",
      "cli": {
        "argstr": "%d",
        "position": -1
      },
      "constraints": {
        "xor": [
          "in_file2",
          "in_float"
        ]
      }
    },
    "out_file": {
      "type": "file",
      "desc": "Output file after calculation",
      "required": true,
      "cli": {
        "argstr": "-o %s"
      }
    }
  },
  "outputs": {
    "out_file": {
      "type": "file",
      "path": {
        "from_input": "out_file"
      },
      "must_exist": false
    }
  },
  "runtime": {
    "container": {
      "type": "none"
    }
  },
  "origin": {
    "source": "nipype",
    "nipype_class": "nipype.interfaces.freesurfer.utils.MRIsCalc",
    "nipype_version": "1.10.0"
  },
  "description": "'mris_calc' is a simple calculator that operates on FreeSurfer"
}
