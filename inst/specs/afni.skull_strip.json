{
  "spec_version": "0.1.0",
  "id": "afni.skull_strip",
  "title": "AFNI SkullStrip",
  "command": "3dSkullStrip",
  "inputs": {
    "args": {
      "type": "string",
      "desc": "Additional parameters to the command",
      "cli": {
        "argstr": "%s"
      }
    },
    "in_file": {
      "type": "file",
      "desc": "input file to 3dSkullStrip",
      "required": true,
      "cli": {
        "argstr": "-input %s",
        "position": 1
      }
    },
    "out_file": {
      "type": "file",
      "desc": "output image file name",
      "cli": {
        "argstr": "-prefix %s"
      }
    }
  },
  "outputs": {
    "out_file": {
      "type": "file",
      "path": {
        "from_input": "out_file"
      },
      "must_exist": false
    }
  },
  "runtime": {
    "profile": "afni"
  },
  "origin": {
    "source": "nipype",
    "nipype_class": "nipype.interfaces.afni.preprocess.SkullStrip",
    "nipype_version": "1.10.0"
  },
  "description": "A program to extract the brain from surrounding tissue from MRI"
}
