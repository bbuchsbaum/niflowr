{
  "spec_version": "0.1.0",
  "id": "freesurfer.segment_wm",
  "title": "FREESURFER SegmentWM",
  "command": "mri_segment",
  "inputs": {
    "args": {
      "type": "string",
      "desc": "Additional parameters to the command",
      "cli": {
        "argstr": "%s"
      }
    },
    "in_file": {
      "type": "file",
      "desc": "Input file for SegmentWM",
      "required": true,
      "cli": {
        "argstr": "%s",
        "position": -2
      }
    },
    "out_file": {
      "type": "file",
      "desc": "File to be written as output for SegmentWM",
      "required": true,
      "cli": {
        "argstr": "%s",
        "position": -1
      }
    }
  },
  "outputs": {
    "out_file": {
      "type": "file",
      "path": {
