{
  "spec_version": "0.1.0",
  "id": "afni.automask",
  "title": "AFNI Automask",
  "command": "3dAutomask",
  "inputs": {
    "args": {
      "type": "string",
      "desc": "Additional parameters to the command",
      "cli": {
        "argstr": "%s"
      }
    },
    "brain_file": {
      "type": "file",
      "desc": "output file from 3dAutomask",
      "cli": {
        "argstr": "-apply_prefix %s"
      }
    },
    "clfrac": {
      "type": "double",
      "desc": "sets the clip level fraction (must be 0.1-0.9). A small value will tend to make the mask larger [default = 0.5].",
      "cli": {
        "argstr": "-clfrac %s"
      }
    },
    "dilate": {
      "type": "int",
      "desc": "dilate the mask outwards",
      "cli": {
        "argstr": "-dilate %s"
      }
    },
    "erode": {
      "type": "int",
      "desc": "erode the mask inwards",
      "cli": {
        "argstr": "-erode %s"
      }
    },
    "in_file": {
      "type": "file",
      "desc": "input file to 3dAutomask",
      "required": true,
      "cli": {
        "argstr": "%s",
        "position": -1
      }
    },
    "out_file": {
      "type": "file",
      "desc": "output image file name",
      "cli": {
        "argstr": "-prefix %s"
      }
    }
  },
  "outputs": {
    "brain_file": {
      "type": "file",
      "path": {
        "from_input": "brain_file"
      },
      "must_exist": false
    },
    "out_file": {
      "type": "file",
      "path": {
        "from_input": "out_file"
      },
      "must_exist": false
    }
  },
  "runtime": {
    "container": {
      "type": "none"
    }
  },
  "origin": {
    "source": "nipype",
    "nipype_class": "nipype.interfaces.afni.preprocess.Automask",
    "nipype_version": "1.10.0"
  },
  "description": "Create a brain-only mask of the image using AFNI 3dAutomask command"
}
