{
  "spec_version": "0.1.0",
  "id": "fsl.apply_warp",
  "title": "FSL ApplyWarp",
  "command": "applywarp",
  "inputs": {
    "abswarp": {
      "type": "flag",
      "desc": "treat warp field as absolute: x' = w(x)",
      "cli": {
        "argstr": "--abs"
      },
      "constraints": {
        "xor": [
          "relwarp"
        ]
      }
    },
    "args": {
      "type": "string",
      "desc": "Additional parameters to the command",
      "cli": {
        "argstr": "%s"
      }
    },
    "datatype": {
      "type": "enum",
      "desc": "Force output data type [char short int float double].",
      "choices": [
        "char",
        "short",
        "int",
        "float",
        "double"
      ],
      "cli": {
        "argstr": "--datatype=%s"
      }
    },
    "field_file": {
      "type": "file",
      "desc": "file containing warp field",
      "cli": {
        "argstr": "--warp=%s"
      }
    },
    "in_file": {
      "type": "file",
      "desc": "image to be warped",
      "required": true,
      "cli": {
        "argstr": "--in=%s",
        "position": 0
      }
    },
    "interp": {
      "type": "enum",
      "desc": "interpolation method",
      "choices": [
        "nn",
        "trilinear",
        "sinc",
        "spline"
      ],
      "cli": {
        "argstr": "--interp=%s",
        "position": -2
      }
    },
    "mask_file": {
      "type": "file",
      "desc": "filename for mask image (in reference space)",
      "cli": {
        "argstr": "--mask=%s"
      }
    },
    "out_file": {
      "type": "file",
      "desc": "output filename",
      "cli": {
        "argstr": "--out=%s",
        "position": 2
      }
    },
    "postmat": {
      "type": "file",
      "desc": "filename for post-transform (affine matrix)",
      "cli": {
        "argstr": "--postmat=%s"
      }
    },
    "premat": {
      "type": "file",
      "desc": "filename for pre-transform (affine matrix)",
      "cli": {
        "argstr": "--premat=%s"
      }
    },
    "ref_file": {
      "type": "file",
      "desc": "reference image",
      "required": true,
      "cli": {
        "argstr": "--ref=%s",
        "position": 1
      }
    },
    "relwarp": {
      "type": "flag",
      "desc": "treat warp field as relative: x' = x + w(x)",
      "cli": {
        "argstr": "--rel",
        "position": -1
      },
      "constraints": {
        "xor": [
          "abswarp"
        ]
      }
    },
    "superlevel": {
      "type": "list",
      "desc": "level of intermediary supersampling, a for 'automatic' or integer level. Default = 2",
      "cli": {
        "argstr": "--superlevel=%s"
      }
    },
    "supersample": {
      "type": "flag",
      "desc": "intermediary supersampling of output, default is off",
      "cli": {
        "argstr": "--super"
      }
    }
  },
  "outputs": {
    "out_file": {
      "type": "file",
      "path": {
        "from_input": "out_file"
      },
      "must_exist": false
    }
  },
  "runtime": {
    "container": {
      "type": "none"
    }
  },
  "origin": {
    "source": "nipype",
    "nipype_class": "nipype.interfaces.fsl.preprocess.ApplyWarp",
    "nipype_version": "1.10.0"
  },
  "description": "FSL's applywarp wrapper to apply the results of a FNIRT registration"
}
