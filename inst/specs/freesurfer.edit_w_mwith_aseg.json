{
  "spec_version": "0.1.0",
  "id": "freesurfer.edit_w_mwith_aseg",
  "title": "FREESURFER EditWMwithAseg",
  "command": "mri_edit_wm_with_aseg",
  "inputs": {
    "args": {
      "type": "string",
      "desc": "Additional parameters to the command",
      "cli": {
        "argstr": "%s"
      }
    },
    "brain_file": {
      "type": "file",
      "desc": "Input brain/T1 file",
      "required": true,
      "cli": {
        "argstr": "%s",
        "position": -3
      }
    },
    "in_file": {
      "type": "file",
      "desc": "Input white matter segmentation file",
      "required": true,
      "cli": {
        "argstr": "%s",
        "position": -4
      }
    },
    "keep_in": {
      "type": "flag",
      "desc": "Keep edits as found in input volume",
      "cli": {
        "argstr": "-keep-in"
      }
    },
    "out_file": {
      "type": "file",
      "desc": "File to be written as output",
      "required": true,
      "cli": {
        "argstr": "%s",
        "position": -1
      }
    },
    "seg_file": {
      "type": "file",
      "desc": "Input presurf segmentation file",
      "required": true,
      "cli": {
        "argstr": "%s",
        "position": -2
      }
    }
  },
  "outputs": {
    "out_file": {
      "type": "file",
      "path": {
        "from_input": "out_file"
      },
      "must_exist": false
    }
  },
  "runtime": {
    "container": {
      "type": "none"
    }
  },
  "origin": {
    "source": "nipype",
    "nipype_class": "nipype.interfaces.freesurfer.preprocess.EditWMwithAseg",
    "nipype_version": "1.10.0"
  },
  "description": "Edits a wm file using a segmentation"
}
