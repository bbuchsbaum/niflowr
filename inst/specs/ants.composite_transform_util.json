{
  "spec_version": "0.1.0",
  "id": "ants.composite_transform_util",
  "title": "ANTS CompositeTransformUtil",
  "command": "CompositeTransformUtil",
  "inputs": {
    "args": {
      "type": "string",
      "desc": "Additional parameters to the command",
      "cli": {
        "argstr": "%s"
      }
    },
    "in_file": {
      "type": "list",
      "desc": "Input transform file(s)",
      "required": true,
      "cli": {
        "argstr": "%s...",
        "position": 3
      }
    },
    "out_file": {
      "type": "file",
      "desc": "Output file path (only used for disassembly).",
      "cli": {
        "argstr": "%s",
        "position": 2
      }
    },
    "output_prefix": {
      "type": "string",
      "desc": "A prefix that is prepended to all output files (only used for assembly).",
      "default": "transform",
      "cli": {
        "argstr": "%s",
        "position": 4
      }
    },
    "process": {
      "type": "enum",
      "desc": "What to do with the transform inputs (assemble or disassemble)",
      "default": "assemble",
      "choices": [
        "assemble",
        "disassemble"
      ],
      "cli": {
        "argstr": "--%s",
        "position": 1
      }
    }
  },
  "outputs": {
    "out_file": {
      "type": "file",
      "path": {
        "from_input": "out_file"
      },
      "must_exist": false
    }
  },
  "runtime": {
    "container": {
      "type": "none"
    }
  },
  "origin": {
    "source": "nipype",
    "nipype_class": "nipype.interfaces.ants.registration.CompositeTransformUtil",
    "nipype_version": "1.10.0"
  },
  "description": "ANTs utility which can combine or break apart transform files into their individual"
}
