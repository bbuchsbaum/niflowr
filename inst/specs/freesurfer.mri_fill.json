{
  "spec_version": "0.1.0",
  "id": "freesurfer.mri_fill",
  "title": "FREESURFER MRIFill",
  "command": "mri_fill",
  "inputs": {
    "args": {
      "type": "string",
      "desc": "Additional parameters to the command",
      "cli": {
        "argstr": "%s"
      }
    },
    "in_file": {
      "type": "file",
      "desc": "Input white matter file",
      "required": true,
      "cli": {
        "argstr": "%s",
        "position": -2
      }
    },
    "log_file": {
      "type": "file",
      "desc": "Output log file for MRIFill",
      "cli": {
        "argstr": "-a %s"
      }
    },
    "out_file": {
      "type": "file",
      "desc": "Output filled volume file name for MRIFill",
      "required": true,
      "cli": {
        "argstr": "%s",
        "position": -1
      }
    },
    "segmentation": {
      "type": "file",
      "desc": "Input segmentation file for MRIFill",
      "cli": {
        "argstr": "-segmentation %s"
      }
    },
    "transform": {
      "type": "file",
      "desc": "Input transform file for MRIFill",
      "cli": {
        "argstr": "-xform %s"
      }
    }
  },
  "outputs": {
    "log_file": {
      "type": "file",
      "path": {
        "from_input": "log_file"
      },
      "must_exist": false
    },
    "out_file": {
      "type": "file",
      "path": {
        "from_input": "out_file"
      },
      "must_exist": false
    }
  },
  "runtime": {
    "profile": "freesurfer"
  },
  "origin": {
    "source": "nipype",
    "nipype_class": "nipype.interfaces.freesurfer.utils.MRIFill",
    "nipype_version": "1.10.0"
  },
  "description": "This program creates hemispheric cutting planes and fills white matter"
}
