{
  "spec_version": "0.1.0",
  "id": "fsl.feat_model",
  "title": "FSL FEATModel",
  "command": "feat_model",
  "inputs": {
    "args": {
      "type": "string",
      "desc": "Additional parameters to the command",
      "cli": {
        "argstr": "%s"
      }
    },
    "ev_files": {
      "type": "list",
      "desc": "Event spec files generated by level1design",
      "required": true,
      "cli": {
        "argstr": "%s",
        "position": 1
      }
    },
    "fsf_file": {
      "type": "file",
      "desc": "File specifying the feat design spec file",
      "required": true,
      "cli": {
        "argstr": "%s",
        "position": 0
      }
    }
  },
  "outputs": {},
  "runtime": {
    "profile": "fsl"
  },
  "origin": {
    "source": "nipype",
    "nipype_class": "nipype.interfaces.fsl.model.FEATModel",
    "nipype_version": "1.10.0"
  },
  "description": "Uses FSL feat_model to generate design.mat files"
}
