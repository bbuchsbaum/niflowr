{
  "spec_version": "0.1.0",
  "id": "fsl.warp_points_from_std",
  "title": "FSL WarpPointsFromStd",
  "command": "std2imgcoord",
  "inputs": {
    "args": {
      "type": "string",
      "desc": "Additional parameters to the command",
      "cli": {
        "argstr": "%s"
      }
    },
    "coord_mm": {
      "type": "flag",
      "desc": "all coordinates in mm",
      "cli": {
        "argstr": "-mm"
      },
      "constraints": {
        "xor": [
          "coord_vox"
        ]
      }
    },
    "coord_vox": {
      "type": "flag",
      "desc": "all coordinates in voxels - default",
      "cli": {
        "argstr": "-vox"
      },
      "constraints": {
        "xor": [
          "coord_mm"
        ]
      }
    },
    "img_file": {
      "type": "file",
      "desc": "filename of a destination image",
      "required": true,
      "cli": {
        "argstr": "-img %s"
      }
    },
    "in_coords": {
      "type": "file",
      "desc": "filename of file containing coordinates",
      "required": true,
      "cli": {
        "argstr": "%s",
        "position": -2
      }
    },
    "std_file": {
      "type": "file",
      "desc": "filename of the image in standard space",
      "required": true,
      "cli": {
        "argstr": "-std %s"
      }
    },
    "warp_file": {
      "type": "file",
      "desc": "filename of warpfield (e.g. intermediate2dest_warp.nii.gz)",
      "cli": {
        "argstr": "-warp %s"
      },
      "constraints": {
        "xor": [
          "xfm_file"
        ]
      }
    },
    "xfm_file": {
      "type": "file",
      "desc": "filename of affine transform (e.g. source2dest.mat)",
      "cli": {
        "argstr": "-xfm %s"
      },
      "constraints": {
        "xor": [
          "warp_file"
        ]
      }
    }
  },
  "outputs": {},
  "runtime": {
    "container": {
      "type": "none"
    }
  },
  "origin": {
    "source": "nipype",
    "nipype_class": "nipype.interfaces.fsl.utils.WarpPointsFromStd",
    "nipype_version": "1.10.0"
  },
  "description": "Use FSL `std2imgcoord <http://fsl.fmrib.ox.ac.uk/fsl/fsl-4.1.9/flirt/overview.html>`_"
}
