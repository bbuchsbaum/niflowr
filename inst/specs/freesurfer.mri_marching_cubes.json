{
  "spec_version": "0.1.0",
  "id": "freesurfer.mri_marching_cubes",
  "title": "FREESURFER MRIMarchingCubes",
  "command": "mri_mc",
  "inputs": {
    "args": {
      "type": "string",
      "desc": "Additional parameters to the command",
      "cli": {
        "argstr": "%s"
      }
    },
    "connectivity_value": {
      "type": "int",
      "desc": "Alter the marching cubes connectivity: 1=6+,2=18,3=6,4=26 (default=1)",
      "default": 1,
      "cli": {
        "argstr": "%d",
        "position": -1
      }
    },
    "in_file": {
      "type": "file",
      "desc": "Input volume to tessellate voxels from.",
      "required": true,
      "cli": {
        "argstr": "%s",
        "position": 1
      }
    },
    "label_value": {
      "type": "int",
      "desc": "Label value which to tessellate from the input volume. (integer, if input is \"filled.mgz\" volume, 127 is rh, 255 is lh)",
      "required": true,
      "cli": {
        "argstr": "%d",
        "position": 2
      }
    },
    "out_file": {
      "type": "file",
      "desc": "output filename or True to generate one",
      "cli": {
        "argstr": "./%s",
        "position": -2
      }
    }
  },
  "outputs": {},
  "runtime": {
    "profile": "freesurfer"
  },
  "origin": {
    "source": "nipype",
    "nipype_class": "nipype.interfaces.freesurfer.utils.MRIMarchingCubes",
    "nipype_version": "1.10.0"
  },
  "description": "Uses Freesurfer's mri_mc to create surfaces by tessellating a given input volume"
}
