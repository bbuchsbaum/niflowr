{
  "spec_version": "0.1.0",
  "id": "fsl.erode_image",
  "title": "FSL ErodeImage",
  "command": "fslmaths",
  "inputs": {
    "args": {
      "type": "string",
      "desc": "Additional parameters to the command",
      "cli": {
        "argstr": "%s"
      }
    },
    "in_file": {
      "type": "file",
      "desc": "image to operate on",
      "required": true,
      "cli": {
        "argstr": "%s",
        "position": 2
      }
    },
    "internal_datatype": {
      "type": "enum",
      "desc": "datatype to use for calculations (default is float)",
      "choices": [
        "float",
        "char",
        "int",
        "short",
        "double",
        "input"
      ],
      "cli": {
        "argstr": "-dt %s",
        "position": 1
      }
    },
    "kernel_file": {
      "type": "file",
      "desc": "use external file for kernel",
      "cli": {
        "argstr": "%s",
        "position": 5
      },
      "constraints": {
        "xor": [
          "kernel_size"
        ]
      }
    },
    "kernel_shape": {
      "type": "enum",
      "desc": "kernel shape to use",
      "choices": [
        "3D",
        "2D",
        "box",
        "boxv",
        "gauss",
        "sphere",
        "file"
      ],
      "cli": {
        "argstr": "-kernel %s",
        "position": 4
      }
    },
    "kernel_size": {
      "type": "double",
      "desc": "kernel size - voxels for box/boxv, mm for sphere, mm sigma for gauss",
      "cli": {
        "argstr": "%.4f"
      },
      "constraints": {
        "xor": [
          "kernel_file"
        ]
      }
    },
    "minimum_filter": {
      "type": "bool",
      "desc": "if true, minimum filter rather than erosion by zeroing-out",
      "default": false,
      "cli": {
        "argstr": "%s",
        "position": 6
      }
    },
    "nan2zeros": {
      "type": "flag",
      "desc": "change NaNs to zeros before doing anything",
      "cli": {
        "argstr": "-nan",
        "position": 3
      }
    },
    "out_file": {
      "type": "file",
      "desc": "image to write",
      "cli": {
        "argstr": "%s",
        "position": -2
      }
    },
    "output_datatype": {
      "type": "enum",
      "desc": "datatype to use for output (default uses input type)",
      "choices": [
        "float",
        "char",
        "int",
        "short",
        "double",
        "input"
      ],
      "cli": {
        "argstr": "-odt %s",
        "position": -1
      }
    }
  },
  "outputs": {
    "out_file": {
      "type": "file",
      "path": {
        "from_input": "out_file"
      },
      "must_exist": false
    }
  },
  "runtime": {
    "profile": "fsl"
  },
  "origin": {
    "source": "nipype",
    "nipype_class": "nipype.interfaces.fsl.maths.ErodeImage",
    "nipype_version": "1.10.0"
  },
  "description": "Use fslmaths to perform a spatial erosion of an image."
}
