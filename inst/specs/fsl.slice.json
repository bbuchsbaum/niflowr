{
  "spec_version": "0.1.0",
  "id": "fsl.slice",
  "title": "FSL Slice",
  "command": "fslslice",
  "inputs": {
    "args": {
      "type": "string",
      "desc": "Additional parameters to the command",
      "cli": {
        "argstr": "%s"
      }
    },
    "in_file": {
      "type": "file",
      "desc": "input filename",
      "required": true,
      "cli": {
        "argstr": "%s",
        "position": 0
      }
    },
    "out_base_name": {
      "type": "string",
      "desc": "outputs prefix",
      "cli": {
        "argstr": "%s",
        "position": 1
      }
    }
  },
  "outputs": {},
  "runtime": {
    "profile": "fsl"
  },
  "origin": {
    "source": "nipype",
    "nipype_class": "nipype.interfaces.fsl.utils.Slice",
    "nipype_version": "1.10.0"
  },
  "description": "Use fslslice to split a 3D file into lots of 2D files (along z-axis)."
}
