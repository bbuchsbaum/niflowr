{
  "spec_version": "0.1.0",
  "id": "afni.copy",
  "title": "AFNI Copy",
  "command": "3dcopy",
  "inputs": {
    "args": {
      "type": "string",
      "desc": "Additional parameters to the command",
      "cli": {
        "argstr": "%s"
      }
    },
    "in_file": {
      "type": "file",
      "desc": "input file to 3dcopy",
      "required": true,
      "cli": {
        "argstr": "%s",
        "position": -2
      }
    },
    "out_file": {
      "type": "file",
      "desc": "output image file name",
      "cli": {
        "argstr": "%s",
        "position": -1
      }
    },
    "verbose": {
      "type": "flag",
      "desc": "print progress reports",
      "cli": {
        "argstr": "-verb"
      }
    }
  },
  "outputs": {
    "out_file": {
      "type": "file",
      "path": {
        "from_input": "out_file"
      },
      "must_exist": false
    }
  },
  "runtime": {
    "profile": "afni"
  },
  "origin": {
    "source": "nipype",
    "nipype_class": "nipype.interfaces.afni.utils.Copy",
    "nipype_version": "1.10.0"
  },
  "description": "Copies an image of one type to an image of the same"
}
