{
  "spec_version": "0.1.0",
  "id": "afni.z_cut_up",
  "title": "AFNI ZCutUp",
  "command": "3dZcutup",
  "inputs": {
    "args": {
      "type": "string",
      "desc": "Additional parameters to the command",
      "cli": {
        "argstr": "%s"
      }
    },
    "in_file": {
      "type": "file",
      "desc": "input file to 3dZcutup",
      "required": true,
      "cli": {
        "argstr": "%s",
        "position": -1
      }
    },
    "keep": {
      "type": "string",
      "desc": "slice range to keep in output",
      "cli": {
        "argstr": "-keep %s"
      }
    },
    "out_file": {
      "type": "file",
      "desc": "output image file name",
      "cli": {
        "argstr": "-prefix %s"
      }
    }
  },
  "outputs": {
    "out_file": {
      "type": "file",
      "path": {
        "from_input": "out_file"
      },
      "must_exist": false
    }
  },
  "runtime": {
    "container": {
      "type": "none"
    }
  },
  "origin": {
    "source": "nipype",
    "nipype_class": "nipype.interfaces.afni.utils.ZCutUp",
    "nipype_version": "1.10.0"
  },
  "description": "Cut z-slices from a volume using AFNI 3dZcutup command"
}
