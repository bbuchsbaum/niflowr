{
  "spec_version": "0.1.0",
  "id": "afni.t_correlate",
  "title": "AFNI TCorrelate",
  "command": "3dTcorrelate",
  "inputs": {
    "args": {
      "type": "string",
      "desc": "Additional parameters to the command",
      "cli": {
        "argstr": "%s"
      }
    },
    "out_file": {
      "type": "file",
      "desc": "output image file name",
      "cli": {
        "argstr": "-prefix %s"
      }
    },
    "pearson": {
      "type": "flag",
      "desc": "Correlation is the normal Pearson correlation coefficient",
      "cli": {
        "argstr": "-pearson"
      }
    },
    "polort": {
      "type": "int",
      "desc": "Remove polynomial trend of order m",
      "cli": {
        "argstr": "-polort %d"
      }
    },
    "xset": {
      "type": "file",
      "desc": "input xset",
      "required": true,
      "cli": {
        "argstr": "%s",
        "position": -2
      }
    },
    "yset": {
      "type": "file",
      "desc": "input yset",
      "required": true,
      "cli": {
        "argstr": "%s",
        "position": -1
      }
    }
  },
  "outputs": {
    "out_file": {
      "type": "file",
      "path": {
        "from_input": "out_file"
      },
      "must_exist": false
    }
  },
  "runtime": {
    "profile": "afni"
  },
  "origin": {
    "source": "nipype",
    "nipype_class": "nipype.interfaces.afni.preprocess.TCorrelate",
    "nipype_version": "1.10.0"
  },
  "description": "Computes the correlation coefficient between corresponding voxel"
}
