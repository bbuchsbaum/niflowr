{
  "spec_version": "0.1.0",
  "id": "fsl.plot_motion_params",
  "title": "FSL PlotMotionParams",
  "command": "fsl_tsplot",
  "inputs": {
    "args": {
      "type": "string",
      "desc": "Additional parameters to the command",
      "cli": {
        "argstr": "%s"
      }
    },
    "in_file": {
      "type": "list",
      "desc": "file with motion parameters",
      "required": true,
      "cli": {
        "argstr": "%s",
        "position": 1
      }
    },
    "in_source": {
      "type": "enum",
      "desc": "which program generated the motion parameter file - fsl, spm",
      "required": true,
      "choices": [
        "spm",
        "fsl"
      ]
    },
    "out_file": {
      "type": "file",
      "desc": "image to write",
      "cli": {
        "argstr": "-o %s"
      }
    },
    "plot_size": {
      "type": "list",
      "desc": "plot image height and width",
      "cli": {
        "argstr": "%s"
      }
    },
    "plot_type": {
      "type": "enum",
      "desc": "which motion type to plot - rotations, translations, displacement",
      "required": true,
      "choices": [
        "rotations",
        "translations",
        "displacement"
      ],
      "cli": {
        "argstr": "%s"
      }
    }
  },
  "outputs": {
    "out_file": {
      "type": "file",
      "path": {
        "from_input": "out_file"
      },
      "must_exist": false
    }
  },
  "runtime": {
    "profile": "fsl"
  },
  "origin": {
    "source": "nipype",
    "nipype_class": "nipype.interfaces.fsl.utils.PlotMotionParams",
    "nipype_version": "1.10.0"
  },
  "description": "Use fsl_tsplot to plot the estimated motion parameters from a"
}
