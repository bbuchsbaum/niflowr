{
  "spec_version": "0.1.0",
  "id": "fsl.unary_maths",
  "title": "FSL UnaryMaths",
  "command": "fslmaths",
  "inputs": {
    "args": {
      "type": "string",
      "desc": "Additional parameters to the command",
      "cli": {
        "argstr": "%s"
      }
    },
    "in_file": {
      "type": "file",
      "desc": "image to operate on",
      "required": true,
      "cli": {
        "argstr": "%s",
        "position": 2
      }
    },
    "internal_datatype": {
      "type": "enum",
      "desc": "datatype to use for calculations (default is float)",
      "choices": [
        "float",
        "char",
        "int",
        "short",
        "double",
        "input"
      ],
      "cli": {
        "argstr": "-dt %s",
        "position": 1
      }
    },
    "nan2zeros": {
      "type": "flag",
      "desc": "change NaNs to zeros before doing anything",
      "cli": {
        "argstr": "-nan",
        "position": 3
      }
    },
    "operation": {
      "type": "enum",
      "desc": "operation to perform",
      "required": true,
      "choices": [
        "exp",
        "log",
        "sin",
        "cos",
        "tan",
        "asin",
        "acos",
        "atan",
        "sqr",
        "sqrt",
        "recip",
        "abs",
        "bin",
        "binv",
        "fillh",
        "fillh26",
        "index",
        "edge",
        "nan",
        "nanm",
        "rand",
        "randn",
        "range"
      ],
      "cli": {
        "argstr": "-%s",
        "position": 4
      }
    },
    "out_file": {
      "type": "file",
      "desc": "image to write",
      "cli": {
        "argstr": "%s",
        "position": -2
      }
    },
    "output_datatype": {
      "type": "enum",
      "desc": "datatype to use for output (default uses input type)",
      "choices": [
        "float",
        "char",
        "int",
        "short",
        "double",
        "input"
      ],
      "cli": {
        "argstr": "-odt %s",
        "position": -1
      }
    }
  },
  "outputs": {
    "out_file": {
      "type": "file",
      "path": {
        "from_input": "out_file"
      },
      "must_exist": false
    }
  },
  "runtime": {
    "container": {
      "type": "none"
    }
  },
  "origin": {
    "source": "nipype",
    "nipype_class": "nipype.interfaces.fsl.maths.UnaryMaths",
    "nipype_version": "1.10.0"
  },
  "description": "Use fslmaths to perorm a variety of mathematical operations on an image."
}
