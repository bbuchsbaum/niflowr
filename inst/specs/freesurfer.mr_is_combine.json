{
  "spec_version": "0.1.0",
  "id": "freesurfer.mr_is_combine",
  "title": "FREESURFER MRIsCombine",
  "command": "mris_convert",
  "inputs": {
    "args": {
      "type": "string",
      "desc": "Additional parameters to the command",
      "cli": {
        "argstr": "%s"
      }
    },
    "in_files": {
      "type": "list",
      "desc": "Two surfaces to be combined.",
      "required": true,
      "cli": {
        "argstr": "--combinesurfs %s",
        "position": 1
      }
    },
    "out_file": {
      "type": "file",
      "desc": "Output filename. Combined surfaces from in_files.",
      "required": true,
      "cli": {
        "argstr": "%s",
        "position": -1
      }
    }
  },
  "outputs": {
    "out_file": {
      "type": "file",
      "path": {
        "from_input": "out_file"
      },
      "must_exist": false
    }
  },
  "runtime": {
    "container": {
      "type": "none"
    }
  },
  "origin": {
    "source": "nipype",
    "nipype_class": "nipype.interfaces.freesurfer.utils.MRIsCombine",
    "nipype_version": "1.10.0"
  },
  "description": "Uses Freesurfer's ``mris_convert`` to combine two surface files into one."
}
