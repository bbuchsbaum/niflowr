{
  "spec_version": "0.1.0",
  "id": "fsl.binary_maths",
  "title": "FSL BinaryMaths",
  "command": "fslmaths",
  "inputs": {
    "args": {
      "type": "string",
      "desc": "Additional parameters to the command",
      "cli": {
        "argstr": "%s"
      }
    },
    "in_file": {
      "type": "file",
      "desc": "image to operate on",
      "required": true,
      "cli": {
        "argstr": "%s",
        "position": 2
      }
    },
    "internal_datatype": {
      "type": "enum",
      "desc": "datatype to use for calculations (default is float)",
      "choices": [
        "float",
        "char",
        "int",
        "short",
        "double",
        "input"
      ],
      "cli": {
        "argstr": "-dt %s",
        "position": 1
      }
    },
    "nan2zeros": {
      "type": "flag",
      "desc": "change NaNs to zeros before doing anything",
      "cli": {
        "argstr": "-nan",
        "position": 3
      }
    },
    "operand_file": {
      "type": "file",
      "desc": "second image to perform operation with",
      "required": true,
      "cli": {
        "argstr": "%s",
        "position": 5
      },
      "constraints": {
        "xor": [
          "operand_value"
        ]
      }
    },
    "operand_value": {
      "type": "double",
      "desc": "value to perform operation with",
      "required": true,
      "cli": {
        "argstr": "%.8f"
      },
      "constraints": {
        "xor": [
          "operand_file"
        ]
      }
    },
    "operation": {
      "type": "enum",
      "desc": "operation to perform",
      "required": true,
      "choices": [
        "add",
        "sub",
        "mul",
        "div",
        "rem",
        "max",
        "min"
      ],
      "cli": {
        "argstr": "-%s",
        "position": 4
      }
    },
    "out_file": {
      "type": "file",
      "desc": "image to write",
      "cli": {
        "argstr": "%s",
        "position": -2
      }
    },
    "output_datatype": {
      "type": "enum",
      "desc": "datatype to use for output (default uses input type)",
      "choices": [
        "float",
        "char",
        "int",
        "short",
        "double",
        "input"
      ],
      "cli": {
        "argstr": "-odt %s",
        "position": -1
      }
    }
  },
  "outputs": {
    "out_file": {
      "type": "file",
      "path": {
        "from_input": "out_file"
      },
      "must_exist": false
    }
  },
  "runtime": {
    "container": {
      "type": "none"
    }
  },
  "origin": {
    "source": "nipype",
    "nipype_class": "nipype.interfaces.fsl.maths.BinaryMaths",
    "nipype_version": "1.10.0"
  },
  "description": "Use fslmaths to perform mathematical operations using a second image or"
}
