{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "niflowr interface spec",
  "description": "Declarative specification for a neuroimaging command-line tool interface",
  "type": "object",
  "required": ["spec_version", "id", "command", "inputs", "outputs"],
  "properties": {
    "spec_version": {
      "type": "string",
      "description": "Semantic version of the spec schema"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)*$",
      "description": "Stable identifier, e.g. fsl.bet"
    },
    "title": {
      "type": "string",
      "description": "Human-readable tool name"
    },
    "description": {
      "type": "string",
      "description": "Brief description of what the tool does"
    },
    "command": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      ],
      "description": "Command name or command vector"
    },
    "render": {
      "type": "string",
      "description": "Name of a registered custom renderer to build the argument vector instead of the generic per-input loop (e.g. 'ants_registration_staged')."
    },
    "output_resolver": { "type": "string", "description": "Registered resolver for computed output collections." },
    "inputs": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/param" },
      "description": "Named map of input parameters"
    },
    "outputs": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/output" },
      "description": "Named map of expected outputs"
    },
    "runtime": { "$ref": "#/$defs/runtime" },
    "origin": { "$ref": "#/$defs/origin" }
  },
  "additionalProperties": false,
  "$defs": {
    "param": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["file", "dir", "string", "int", "double", "bool", "flag", "enum", "list"]
        },
        "role": { "enum": ["input", "output", "inout"] },
        "desc": { "type": "string" },
        "required": { "type": "boolean", "default": false },
        "default": {},
        "choices": {
          "type": "array",
          "items": {},
          "minItems": 1,
          "description": "Allowed values for enum type"
        },
        "items_type": {
          "type": "string",
          "enum": ["file", "dir", "string", "int", "double", "bool", "enum"],
          "description": "Element type for list inputs."
        },
        "path_sentinels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Exact backend literals accepted in place of a file or directory path. Sentinels are rendered verbatim and are never resolved, staged, mounted, or identity-checked as paths."
        },
        "cli": { "$ref": "#/$defs/cli" },
        "validate": { "$ref": "#/$defs/validate" },
        "constraints": { "$ref": "#/$defs/constraints" }
      },
      "additionalProperties": false
    },
    "cli": {
      "type": "object",
      "properties": {
        "argstr": {
          "type": "string",
          "description": "printf-style format string for CLI rendering, e.g. '-f %f'"
        },
        "position": {
          "type": "integer",
          "description": "Ordering for positional arguments (negative = from end)"
        },
        "sep": {
          "type": "string",
          "description": "Separator for joining list values"
        },
        "repeat": {
          "type": "boolean",
          "default": false,
          "description": "Repeat the flag for each list element"
        },
        "stdout_to": {
          "type": "string",
          "description": "Input name whose value is used as stdout redirect path (runner-level)"
        },
        "stderr_to": {
          "type": "string",
          "description": "Input name whose value is used as stderr redirect path (runner-level)"
        },
        "strip_ext": {
          "type": "boolean",
          "default": false,
          "description": "Strip known neuroimaging extensions (.nii.gz, .nii, ...) from the value before CLI rendering. Use for FSL -out / out_basename style arguments that append FSLOUTPUTTYPE themselves."
        }
      },
      "additionalProperties": false
    },
    "validate": {
      "type": "object",
      "properties": {
        "exists": {
          "type": "boolean",
          "description": "File/dir must exist"
        },
        "min": {
          "type": "number",
          "description": "Minimum numeric value"
        },
        "max": {
          "type": "number",
          "description": "Maximum numeric value"
        },
        "regex": {
          "type": "string",
          "description": "Value must match this regex"
        }
      },
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "properties": {
        "xor": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Mutually exclusive parameter group"
        },
        "requires": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Parameters that must also be set"
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": ["type", "path"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["file", "dir", "text", "list"]
        },
        "path": {
          "oneOf": [
            {
              "type": "object",
              "required": ["computed"],
              "properties": { "computed": { "const": true } },
              "additionalProperties": false,
              "description": "The registered output_resolver supplies these paths."
            },
            {
              "type": "object",
              "required": ["from_input"],
              "properties": {
                "from_input": { "type": "string" }
              },
              "additionalProperties": false,
              "description": "Output path taken directly from an input value"
            },
            {
              "type": "object",
              "required": ["template"],
              "properties": {
                "template": { "type": "string" }
              },
              "additionalProperties": false,
              "description": "Output path computed from a glue-style template using input values"
            },
            {
              "type": "object",
              "required": ["static"],
              "properties": {
                "static": { "type": "string" }
              },
              "additionalProperties": false,
              "description": "Fixed output path"
            }
          ]
        },
        "must_exist": {
          "type": "boolean",
          "default": true,
          "description": "Whether to verify this output exists after execution"
        },
        "nonempty": {
          "type": "boolean",
          "default": false,
          "description": "Whether an existing output must also contain data (positive file size or at least one directory entry)."
        },
        "transform": { "$ref": "#/$defs/transform" },
        "when": { "$ref": "#/$defs/when" }
      },
      "additionalProperties": false
    },
    "transform": {
      "type": "object",
      "required": ["kind", "format", "source", "target"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["affine", "affine_array", "warp", "composite"],
          "description": "Geometric transform payload represented by this output."
        },
        "format": {
          "type": "string",
          "enum": ["generic", "fsl", "itk", "afni", "lta", "ants", "ants_h5", "fsl_coef", "x5"],
          "description": "On-disk transform convention, separate from filename extension."
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "Input whose image defines the moving/source domain."
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "description": "Input whose image defines the fixed/target domain."
        }
      },
      "additionalProperties": false
    },
    "when": {
      "type": "object",
      "required": ["input"],
      "properties": {
        "input": {
          "type": "string",
          "description": "Input name whose value (with defaults applied) gates this output."
        },
        "in": {
          "type": "array",
          "items": {},
          "description": "Output is produced only when the input value is one of these."
        },
        "not_in": {
          "type": "array",
          "items": {},
          "description": "Output is produced only when the input value is NOT one of these."
        }
      },
      "oneOf": [
        { "required": ["in"] },
        { "required": ["not_in"] }
      ],
      "additionalProperties": false,
      "description": "Conditional gate: include this output only when the predicate over an input value holds. Exactly one of 'in' or 'not_in' must be given."
    },
    "runtime": {
      "type": "object",
      "properties": {
        "cwd": {
          "type": "string",
          "description": "Working directory override"
        },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Environment variables"
        },
        "version": {
          "type": "object",
          "properties": {
            "args": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Args to probe tool version, e.g. ['--version']"
            }
          },
          "additionalProperties": false
        },
        "engine": {
          "type": "string",
          "enum": ["auto", "native", "docker", "apptainer"],
          "description": "Optional per-spec engine preference."
        },
        "profile": {
          "type": "string",
          "description": "Execution profile ID from niflowr.yml profiles."
        }
      },
      "required": ["profile"],
      "additionalProperties": false
    },
    "origin": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "enum": ["manual", "nipype"]
        },
        "nipype_class": { "type": "string" },
        "nipype_version": { "type": "string" },
        "imported_at": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
