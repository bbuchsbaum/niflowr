{
  "outputs": {
    "out_file": {
      "type": "file",
      "path": {
        "from_input": "out_file"
      },
      "must_exist": true
    },
    "out_matrix_file": {
      "type": "file",
      "path": {
        "from_input": "out_matrix_file"
      },
      "must_exist": true
    }
  },
  "runtime": {
    "profile": "fsl",
    "env": {
      "FSLOUTPUTTYPE": "NIFTI_GZ"
    }
  }
}
