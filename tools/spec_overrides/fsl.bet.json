{
  "outputs": {
    "out_file": {
      "type": "file",
      "path": {
        "from_input": "out_file"
      },
      "must_exist": true,
      "when": {
        "input": "no_output",
        "not_in": [
          true
        ]
      }
    },
    "mask_file": {
      "type": "file",
      "path": {
        "template": "{out_file}_mask.nii.gz"
      },
      "when": {
        "input": "mask",
        "in": [
          true
        ]
      },
      "must_exist": true
    }
  },
  "runtime": {
    "profile": "fsl",
    "env": {
      "FSLOUTPUTTYPE": "NIFTI_GZ"
    }
  },
  "inputs": {
    "no_output": {
      "type": "flag",
      "desc": "Don't generate segmented output",
      "cli": {
        "argstr": "-n"
      },
      "default": false
    }
  }
}
