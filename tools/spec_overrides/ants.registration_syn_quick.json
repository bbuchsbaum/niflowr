{
  "inputs": {
    "output_prefix": {
      "required": true
    }
  },
  "outputs": {
    "out_matrix": {
      "type": "file",
      "path": { "template": "{output_prefix}0GenericAffine.mat" },
      "must_exist": false
    },
    "warped_image": {
      "type": "file",
      "path": { "template": "{output_prefix}Warped.nii.gz" },
      "must_exist": false
    },
    "inverse_warped_image": {
      "type": "file",
      "path": { "template": "{output_prefix}InverseWarped.nii.gz" },
      "must_exist": false
    },
    "forward_warp_field": {
      "type": "file",
      "path": { "template": "{output_prefix}1Warp.nii.gz" },
      "must_exist": false,
      "when": { "input": "transform_type", "not_in": ["t", "r", "a"] }
    },
    "inverse_warp_field": {
      "type": "file",
      "path": { "template": "{output_prefix}1InverseWarp.nii.gz" },
      "must_exist": false,
      "when": { "input": "transform_type", "not_in": ["t", "r", "a"] }
    }
  }
}
